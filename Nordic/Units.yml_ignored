extends: existence
message: "Don't spell out the number in '%s'."
# Disabled: deferred conflict C8 (units-of-measurement.md:13-15 vs numbers.md:123).
# Source: units-of-measurement.md, "Always use abbreviated units in all contexts."
link: https://nordicplayground.github.io/techdocs-style-guide/units-of-measurement/#formatting-guidelines
level: error
raw:
  - '[a-zA-Z]+\s'
tokens:
  - '(?:centi|milli)?meters'
  - '(?:kilo)?grams'
  - '(?:kilo)?meters'
  - '(?:mega)?pixels'
  - cm
  - inches
  - lb
  - miles
  - pounds
